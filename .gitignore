# Firmware (PlatformIO)
Firmware/.pio/
Firmware/.vscode/
*.o

# KiCad — backups, lock files, and regenerable fab output.
# Source of truth is the .kicad_pcb/.kicad_pro/.kicad_sch themselves.
Electronics/*.lck
~*.kicad_pcb.lck
~*.kicad_pro.lck
~*.kicad_sch.lck
*-backups/
Electronics/gerbers*/
fp-info-cache

# Blender autosave
*.blend1
*.blend2

# Mechanical assets — most are not included in this repo (large source
# .blend files / unclear redistribution rights on some reference
# assets). Printable STL/3MF files are allow-listed below (tracked via
# Git LFS, see .gitattributes) since they're the useful build output.
mechanical/*
!mechanical/printables/
!mechanical/printables/**

# Essay draft — not part of the published repo
docs/Proof_of_Feeling_Essay_Draft.md

# OS
Thumbs.db
desktop.ini
.DS_Store
